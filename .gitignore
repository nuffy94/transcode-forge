# uv.lock

# Database
*.db
*.db-journal
*.db-shm
*.db-wal

# Docker
.docker/
.playwright-mcp/

# Tailwind standalone CLI binary cache (downloaded by scripts/build_css.py)
/.tailwind/

# Claude Code agent tooling / local settings — not part of the shipped project
.claude/

# Audit / UX testing artifacts (Playwright screenshots, page snapshots, ad-hoc diffs)
# Audit reports are moved to docs/audits/ when worth keeping.
/[0-9][0-9]-*.png
/[0-9][0-9][a-z]-*.png
/step[0-9]*-*.png
/step[0-9]*-*.md
/*-snapshot.md
# QA sweep artifacts (regenerated each run)
/tests/qa/shots/
# qa/: only the committed tooling ships — agent scratch + screenshots are ignored.
/qa/*
!/qa/instance.py
!/qa/sweep_helpers.py
!/qa/scenarios.md
!/qa/ux-sweep.workflow.js
!/qa/launch_demo.py
/qa_sweep_live.db*
/dashboard.png
/movies.png
/queue.png
/workers.png
/stats.png
/skipped*.png
/diff.txt

# External tool sandboxes / local-only data that landed in the workspace
/data/

# Internal dev/process artifacts — kept locally, not shipped in the repo.
# (Session logs, internal audits, multi-session planning docs, design
# mockups/exports, and generated showcase docs.)
/docs/sessions/
/docs/audits/
/docs/plan.md
/docs/audit-v0.1.0.md
/docs/DECISIONS.md
/plans/
/designs/
/docs/COMPONENT_SHOWCASE.html
