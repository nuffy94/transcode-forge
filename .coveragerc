[run]
branch = True
omit =
    */site-packages/*
    */tests/*
    */test_*.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

# Exclude worker agent as it's a full process that's hard to unit test
omit =
    */worker/agent.py
