# Transcode Forge — environment configuration.
#
# For the Docker install you normally DON'T edit this file by hand:
# `./bootstrap.sh` (or bootstrap.ps1) writes a .env with random secrets
# for you. Copy this to .env only if you prefer to configure by hand.

# --- Secrets (Docker) ---
# Leave blank — bootstrap auto-generates these. If you copy this file to
# .env yourself, bootstrap will NOT overwrite it, so fill in strong
# random values (32+ chars) for both.
TF_PG_PASSWORD=
TF_AUTH_SECRET=

# --- Library paths ---
# Host paths to your media. docker-compose mounts these into the
# scheduler (ro) and worker (rw) at /media/movies and /media/tv.
TF_LIBRARY_MOVIES=./media/movies
TF_LIBRARY_TV=./media/tv

# --- Optional ---
TF_PORT=8000
# TF_BIND=127.0.0.1            # bind the web UI to localhost only (front with a reverse proxy)
# TF_LOG_LEVEL=info            # debug | info | warning | error
# TF_SESSION_SECURE=true       # set when serving over HTTPS (behind a TLS proxy)
# TF_TOKEN_PEPPER=             # HMAC key for worker tokens; defaults to a value
#                              # derived from TF_AUTH_SECRET (pin that and tokens
#                              # survive restarts — no need to set this directly)

# --- S3 object storage (optional, for an S3-library backend) ---
# Leave blank to use filesystem-only. When set, credentials are injected
# via environment (see .env.tpl for the 1Password pattern).
# TF_S3_ENDPOINT_URL=https://s3.example.com
# TF_S3_REGION=us-east-1
# TF_S3_ACCESS_KEY_ID=
# TF_S3_SECRET_ACCESS_KEY=

# --- Database — self-hosted or managed (DBaaS) ---
# Default SQLite (single-node dev; data won't persist if the container is recreated):
# TF_DB_URL=sqlite:///transcode_forge.db
# Self-hosted Postgres (local or on your network):
# TF_DB_URL=postgresql://tf:PASSWORD@localhost:5432/transcode_forge
# Linode Managed Postgres (DBaaS) — sslmode=require is mandatory:
# TF_DB_URL=postgresql://USER:PASSWORD@YOUR-LINODE-DBAAS-HOST:PORT/transcode_forge?sslmode=require

# --- Redis (optional in demo mode) ---
# Docker compose default:
# TF_REDIS_URL=redis://redis:6379/0
# Bare-metal:
# TF_REDIS_URL=redis://localhost:6379/0
