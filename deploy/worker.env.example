# Worker config — copy to worker.env (gitignored) and fill in real values.
# This is loaded by start-transcode-worker.bat (Windows) and is also a
# useful reference for /etc/default/transcode-forge-worker on Linux.

# Identify this worker in the dashboard.
TF_WORKER_NAME=my-worker
TF_PREFERRED_ENCODER=auto

# Connect to the scheduler — issue a token in Settings → Workers and
# paste it here.
TF_SERVER_URL=http://your-scheduler:8000
TF_WORKER_TOKEN=PASTE_THE_TOKEN_HERE

# Path translation: the scheduler stores library paths as it sees them
# (e.g. /media/movies inside its container). The worker may see the
# same library at a different mount point — usually only matters for
# Windows workers reading a Linux NFS share.
#
# Format: JSON dict mapping scheduler-side prefix → worker-side prefix.
# Empty {} if both machines see the library at the same path.
#
# Example for a Windows worker pulling from a Linux scheduler:
#   TF_PATH_MAP={"/media/movies":"Z:\\Movies","/media/tv":"Z:\\TV"}
TF_PATH_MAP={}

TF_LOG_LEVEL=info
